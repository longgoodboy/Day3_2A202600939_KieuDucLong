# Default provider
DEFAULT_PROVIDER=mimo
LOG_LEVEL=INFO

# Xiaomi MiMo - primary provider
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Gemini - optional secondary provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI - optional secondary provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional local provider (GGUF via llama-cpp)
# Download model from: https://huggingface.co/microsoft/Phi-3-mini-4k-instruct-gguf
LOCAL_MODEL_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf
